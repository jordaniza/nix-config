pragma Singleton
import QtQuick

QtObject {
    readonly property color background: "#@background@"
    readonly property color foreground: "#@foreground@"
    readonly property color selection: "#@selection@"
    readonly property color accent: "#@accent@"
    readonly property color critical: "#@critical@"
    readonly property color transparent: "transparent"
    readonly property string uiFont: "@uiFont@"
    readonly property string iconFont: "@monoFont@"
    readonly property int fontSize: 14
    readonly property int iconSize: 18
    readonly property int cornerRadius: @cornerRadius@
}
