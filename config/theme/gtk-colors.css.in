@define-color rice_background #@background@;
@define-color rice_foreground #@foreground@;
@define-color rice_selection #@selection@;
@define-color rice_accent #@accent@;
@define-color rice_muted #@muted@;
@define-color rice_warning #@warning@;
@define-color rice_critical #@critical@;
@define-color rice_yellow #@yellow@;
@define-color rice_green #@green@;
@define-color rice_white #@white@;
