# Dracula powerline layout with a blank row above; keep the session label hidden.
set -g status-position bottom
set -g status 2
# Reset before copying so repeated reloads preserve the tab row.
set -gu status-format
set -gF status-format[1] "#{status-format[0]}"
set -g status-format[0] "#[bg=#@background@,fill=#@background@] "
set -g status-style "fg=#@foreground@,bg=#@selection@"
set -g status-left "#[fg=#@green@,bg=#@background@]#{?client_prefix,#[fg=#@yellow@],}#[fg=#@background@,bg=#@green@]#{?client_prefix,#[bg=#@yellow@],}    #[fg=#@green@,bg=#@selection@]#{?client_prefix,#[fg=#@yellow@],}"
set -g status-left-length 100
set -g status-right "#[fg=#@selection@,bg=#@background@]"
set -g status-right-length 100
set -g status-justify left
set -g window-status-separator " "
set -g window-status-format "#[fg=#@foreground@,bg=#@selection@] #I #W"
set -g window-status-current-format "#[fg=#@selection@,bg=#@comment@]#[fg=#@foreground@,bg=#@comment@] #I #W #[fg=#@comment@,bg=#@selection@]"
set -g window-status-style default
set -g window-status-current-style default
set -g window-status-activity-style bold
set -g window-status-bell-style bold
set -g window-status-last-style default
set -g pane-border-style "fg=#@selection@"
set -g pane-active-border-style "fg=#@accent@"
set -g message-style "fg=#@foreground@,bg=#@selection@"
set -g message-command-style "fg=#@foreground@,bg=#@selection@"
set -g mode-style "fg=#@foreground@,bg=#@selection@"
