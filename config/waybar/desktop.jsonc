// -*- mode: jsonc -*-
{
  // "layer": "top", // Waybar at top layer
  // "position": "bottom", // Waybar position (top|bottom|left|right)
  "height": 30, // Waybar height (to be removed for auto height)
  // "width": 1280, // Waybar width
  "spacing": 4, // Gaps between modules (4px)
  // Choose the order of the modules
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "fixed-center": true,
  "modules-right": [
    "bluetooth",
    "pulseaudio",
    "custom/tmux",
    "custom/notifications",
    "custom/updates",
    "network",
    "custom/power",
  ],
  "tray": {
    // "icon-size": 21,
    "spacing": 10,
    //   "blueman": "bluetooth",
    //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
    // }
  },

  // left
  "hyprland/workspaces": {
    "disable-scroll": true,
    "persistent-workspaces": {
      "*": 4,
    },
  },

  // center
  "clock": {
    "format": "{:%a %d %b  %H:%M:%S}",
    "interval": 1,
    "format-alt": "{:%d/%m/%Y  %H:%M:%S}",
  },

  // right
  "battery": {
    "states": {
      "normal": 89,
      "warning": 19,
      "critical": 9,
    },
    "format": "{capacity}% {icon}",
    "format-full": "{capacity}% {icon}",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    // "format-good": "", // An empty format will hide the module
    // "format-full": "",
    "format-icons": ["", "", "", "", ""],
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
  },

  "bluetooth": {
    "align": 0.5,
    "format": "󰂯",
    "format-connected": "󰂯",
    "format-off": "󰂲",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
    "on-click": "kitty -T bluetuith -e bluetuith",
  },

  "pulseaudio": {
    "align": 0.5,
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-bluetooth-muted": "󰖁",
    "format-muted": "󰖁",
    "format-icons": {
      "headphone": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"],
    },
    "on-click": "kitty -T pulsemixer -e pulsemixer",
  },

  "network": {
    "align": 0.5,
    "format-ethernet": "󰌗",
    "format-wifi": "󰖩 {essid}",
    "format-disconnected": "󰌙",
    "max-length": 24,
    "tooltip-format": "{ifname} → {ipaddr}",
    "tooltip-format-ethernet": "Wired · {ifname} → {ipaddr}",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ifname} → {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "kitty -T nmtui -e nmtui",
  },

  "custom/tmux": {
    "align": 0.5,
    "format": "󰆍",
    "tooltip-format": "tmux · not connected",
  },

  "custom/notifications": {
    "align": 0.5,
    "format": "󰂜",
    "tooltip-format": "Notifications · not connected",
  },

  "custom/updates": {
    "align": 0.5,
    "format": "󰘬",
    "tooltip-format": "Updates · not connected",
  },

  "custom/power": {
    "exec": "power-menu-status",
    "return-type": "json",
    "signal": 8,
    "exec-on-event": false,
    "align": 0.5,
    "format": "󰐥",
    "tooltip": false,
    "on-click": "power-menu",
  },
}
